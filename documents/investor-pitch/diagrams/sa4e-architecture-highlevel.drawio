    </mxCell>
    <mxCell id="n_devops" value="DevOps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=8;" vertex="1" parent="agents_box">
