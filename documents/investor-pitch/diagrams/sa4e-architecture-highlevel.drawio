    </mxCell>
    <mxCell id="n_ui" value="UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=8;" vertex="1" parent="agents_box">
      <mxGeometry x="150" y="125" width="60" height="20" as="geometry"/>
    </mxCell>

    <!-- SM to sub-agents -->
    <mxCell id="e_sm1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#6c8ebf;" edge="1" parent="agents_box" source="n_sm" target="n_ba">
