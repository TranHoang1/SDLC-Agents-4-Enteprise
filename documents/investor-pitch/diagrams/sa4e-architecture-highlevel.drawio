      <mxGeometry x="220" y="90" width="60" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="n_qa" value="QA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="agents_box">
