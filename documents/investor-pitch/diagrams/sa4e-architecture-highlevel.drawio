    <!-- AI Main Agent manages Extension -->
    <mxCell id="e_main_ext" value="manages" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0288d1;strokeWidth=1;dashed=1;fontSize=8;fontStyle=2;" edge="1" parent="ide_box">
      <mxGeometry relative="1" as="geometry">
