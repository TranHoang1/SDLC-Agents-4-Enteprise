      <mxGeometry x="50" y="480" width="400" height="35" as="geometry"/>
    </mxCell>

    <!-- Local note -->
    <mxCell id="local_note" value="All runs locally on user machine" style="text;html=1;align=center;fontSize=8;fontStyle=2;fontColor=#666666;fillColor=none;strokeColor=none;" vertex="1" parent="ide_box">
