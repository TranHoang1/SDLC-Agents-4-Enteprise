    <!-- Main Agent → 9 Agents -->
    <mxCell id="e_main_agents" value="runs" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#0288d1;strokeWidth=2;fontSize=9;fontStyle=1;" edge="1" parent="ide_box" source="main_agent" target="agents_box">
