    <!-- 9 SA4E Agents (run ON the AI Main Agent) -->
    <mxCell id="agents_box" value="SA4E 9 AI Agents (run on AI Main Agent)" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;fontSize=10;rounded=1;" vertex="1" parent="ide_box">
