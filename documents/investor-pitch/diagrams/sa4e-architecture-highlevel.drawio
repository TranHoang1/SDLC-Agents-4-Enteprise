    <!-- Agents → Extension (access MCP tools) -->
    <mxCell id="e_agents_ext" value="call MCP tools" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;fontSize=9;fontStyle=1;" edge="1" parent="ide_box" source="agents_box" target="ext_box">
