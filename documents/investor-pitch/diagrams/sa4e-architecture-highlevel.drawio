<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- USER (standalone, left side) -->
    <mxCell id="n_user" value="User" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="340" width="100" height="80" as="geometry"/>
    </mxCell>

    <!-- IDE BOX (contains AI Main Agent + our 9 agents + Extension) -->
    <mxCell id="ide_box" value="IDE (Kiro / VS Code / Cursor)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#333333;html=1;fontStyle=1;fontSize=11;rounded=1;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="200" y="60" width="500" height="640" as="geometry"/>
    </mxCell>

    <!-- AI Main Agent (inside IDE) -->
    <mxCell id="main_agent" value="AI Main Agent&#xa;(IDE built-in Agentic Engine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontStyle=1;shadow=1;strokeWidth=2;" vertex="1" parent="ide_box">
      <mxGeometry x="80" y="50" width="340" height="60" as="geometry"/>
