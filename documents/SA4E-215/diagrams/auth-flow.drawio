<mxfile host="app.diagrams.net" modified="2026-08-26T02:00:00Z" agent="opencode" version="21.0.0">
  <diagram id="auth-flow" name="Auth Flow">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Auth Flow - SA4E-215 (real: pbkdf2 + group RBAC)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="640" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="Client" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="40" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="reg" value="POST /api/sa4e-215/auth/register&lt;br/&gt;{ email, password, access_group_id? }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="70" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="login" value="POST /api/sa4e-215/auth/login&lt;br/&gt;{ email, password }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="150" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="hash" value="verifyPassword / hashPassword&lt;br/&gt;pbkdf2(salt:hash, sha512, 10k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="100" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="token" value="generateToken&lt;br/&gt;claims: { user_id, access_group_id }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="190" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rbac" value="RBAC: access_group_id -&gt; access_groups -&gt; group_permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="resp" value="200 { token, user{user_id,email,access_group_id,status} }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="270" width="300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="users" value="users table (REAL)&lt;br/&gt;user_id TEXT PK, password_hash,&lt;br/&gt;access_group_id, status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="groups" value="access_groups +&lt;br/&gt;group_permissions (REAL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="280" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="client" target="reg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="client" target="login">
          <mxGeometry relative="1" as="geometry"/>
