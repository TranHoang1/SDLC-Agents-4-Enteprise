        <mxCell id="title" value="API Usage - SA4E-215 (Auth + Decisions + MCP)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="620" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="AUTH&lt;br/&gt;POST /api/sa4e-215/auth/register&lt;br/&gt;POST /api/sa4e-215/auth/login&lt;br/&gt;POST /api/sa4e-215/auth/logout" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontFamily=monospace;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="dec" value="DECISIONS&lt;br/&gt;POST /api/sa4e-215/decisions/evaluate&lt;br/&gt;GET  /api/sa4e-215/decisions/history" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=monospace;spacingLeft=8;" vertex="1" parent="1">
