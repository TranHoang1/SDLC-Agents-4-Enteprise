        <mxCell id="mcp" value="MCP SERVERS&lt;br/&gt;GET    /api/sa4e-215/mcp-servers&lt;br/&gt;POST   /api/sa4e-215/mcp-servers&lt;br/&gt;GET    /api/sa4e-215/mcp-servers/:id&lt;br/&gt;PUT    /api/sa4e-215/mcp-servers/:id&lt;br/&gt;DELETE /api/sa4e-215/mcp-servers/:id" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontFamily=monospace;spacingLeft=8;" vertex="1" parent="1">
