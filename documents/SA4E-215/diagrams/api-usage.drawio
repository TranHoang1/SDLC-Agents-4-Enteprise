        <mxCell id="resp" value="Common response envelopes:&lt;br/&gt;{ success, data, meta }&lt;br/&gt;{ success:false, error:{ code, message } }&lt;br/&gt;Error codes: ERR_001 (validation),&lt;br/&gt;ERR_002 (auth), ERR_004 (not found)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontFamily=monospace;spacingLeft=8;" vertex="1" parent="1">
