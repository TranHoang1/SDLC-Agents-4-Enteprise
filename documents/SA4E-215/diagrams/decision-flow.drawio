        <mxCell id="tables" value="decisions + users tables&lt;br/&gt;(join user.email, role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
