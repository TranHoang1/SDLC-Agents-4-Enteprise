<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Title -->
    <mxCell id="title" value="DiffTracker State Machine" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="400" y="10" width="250" height="30" as="geometry"/>
    </mxCell>
    <!-- Initial state (black dot) -->
    <mxCell id="s0" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="100" y="90" width="20" height="20" as="geometry"/>
    </mxCell>
    <!-- State: Uninitialized -->
    <mxCell id="s1" value="Uninitialized&#xa;(no session)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="160" width="150" height="60" as="geometry"/>
    </mxCell>
    <!-- State: Empty -->
    <mxCell id="s2" value="Empty&#xa;(session active, 0 entries)&#xa;Badge: hidden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="160" width="200" height="70" as="geometry"/>
    </mxCell>
    <!-- State: Tracking -->
    <mxCell id="s3" value="Tracking&#xa;(1..100 entries)&#xa;Badge: visible (count)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="620" y="160" width="200" height="70" as="geometry"/>
    </mxCell>
    <!-- State: Full -->
    <mxCell id="s4" value="Full&#xa;(100 entries — evicting oldest)&#xa;Badge: 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="620" y="350" width="200" height="70" as="geometry"/>
    </mxCell>
    <!-- State: Viewing -->
    <mxCell id="s5" value="Viewing Summary&#xa;(panel open)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="350" width="180" height="60" as="geometry"/>
    </mxCell>
    <!-- Edges -->
    <!-- Initial → Uninitialized -->
    <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="s0" target="s1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Uninitialized → Empty: session created -->
    <mxCell id="e2" value="ensureSession()&#xa;→ session resolved" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Empty → Tracking: first change recorded -->
    <mxCell id="e3" value="recordChange()&#xa;→ first entry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Tracking → Full: 100 entries -->
    <mxCell id="e4" value="recordChange()&#xa;entries.size = 100" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s3" target="s4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Full → Tracking: after eviction, net-zero -->
    <mxCell id="e5" value="evict oldest /&#xa;net-zero removal" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="570" y="385"/>
          <mxPoint x="570" y="290"/>
          <mxPoint x="860" y="290"/>
          <mxPoint x="860" y="209"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Tracking → Empty: new session (reset) -->
    <mxCell id="e6" value="SESSION_CREATED&#xa;→ clearSession()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="720" y="110"/>
          <mxPoint x="400" y="110"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Full → Empty: new session (reset) -->
    <mxCell id="e7" value="SESSION_CREATED&#xa;→ clearSession()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="620" y="480"/>
          <mxPoint x="300" y="480"/>
          <mxPoint x="300" y="230"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Tracking → Viewing: /diff command -->
    <mxCell id="e8" value="/diff command&#xa;or badge click" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s5">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="670" y="310"/>
          <mxPoint x="520" y="310"/>
          <mxPoint x="520" y="380"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Viewing → Tracking: panel closed -->
    <mxCell id="e9" value="panel closed /&#xa;new change arrives" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="390" y="310"/>
          <mxPoint x="720" y="310"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Tracking self-loop: recordChange (same file cumulative) -->
    <mxCell id="e10" value="recordChange()&#xa;(same file → merge)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="870" y="181"/>
          <mxPoint x="870" y="209"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Legend -->
    <mxCell id="legend" value="Legend:&#xa;● Green = new states (DiffTracker)&#xa;● Blue = active tracking&#xa;● Yellow = capacity warning&#xa;● Purple = UI interaction mode&#xa;● Gray = inactive" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="350" width="200" height="100" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
