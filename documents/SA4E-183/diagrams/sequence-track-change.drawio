<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Participants -->
    <mxCell id="h1" value="LangGraph Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="140" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h2" value="OpenCodeToolHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="260" y="20" width="170" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h3" value="DiffTracker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="510" y="20" width="140" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h4" value="PostMessage Bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="730" y="20" width="150" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="h5" value="Webview Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="960" y="20" width="130" height="40" as="geometry"/>
    </mxCell>
    <!-- Lifelines -->
    <mxCell id="l1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="110" y="60" as="sourcePoint"/>
        <mxPoint x="110" y="580" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="345" y="60" as="sourcePoint"/>
        <mxPoint x="345" y="580" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="580" y="60" as="sourcePoint"/>
        <mxPoint x="580" y="580" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="805" y="60" as="sourcePoint"/>
        <mxPoint x="805" y="580" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l5" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1025" y="60" as="sourcePoint"/>
        <mxPoint x="1025" y="580" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- Messages -->
    <!-- 1. LangGraph → ToolHandler: invoke applyDiff -->
    <mxCell id="m1" value="1. invoke applyDiff(diffBlock)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="110" y="100" as="sourcePoint"/>
        <mxPoint x="345" y="100" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 2. ToolHandler executes edit (self-call notation) -->
    <mxCell id="m2" value="2. executeWorkspaceEdit(diff)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="345" y="150" as="sourcePoint"/>
        <mxPoint x="410" y="150" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 3. ToolHandler → ToolHandler: success -->
    <mxCell id="m3" value="3. ApplyResult { success: true }" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="410" y="190" as="sourcePoint"/>
        <mxPoint x="345" y="190" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 4. ToolHandler → DiffTracker: recordChange -->
    <mxCell id="m4" value="4. recordChange({ filePath, operation, linesAdded, linesRemoved, diffContent })" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="345" y="240" as="sourcePoint"/>
        <mxPoint x="580" y="240" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 5. DiffTracker validates and stores -->
    <mxCell id="m5" value="5. validate entry, store/merge in Map" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="580" y="290" as="sourcePoint"/>
        <mxPoint x="640" y="290" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 6. DiffTracker → PostMessage Bridge: count update -->
    <mxCell id="m6" value="6. send DIFF_COUNT_UPDATED { count: N }" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="580" y="340" as="sourcePoint"/>
        <mxPoint x="805" y="340" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 7. PostMessage Bridge → Webview Store -->
    <mxCell id="m7" value="7. postMessage → onMessage handler" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="805" y="390" as="sourcePoint"/>
        <mxPoint x="1025" y="390" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 8. Webview Store updates badge -->
    <mxCell id="m8" value="8. diffTrackerStore.set({ fileCount: N })" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1025" y="440" as="sourcePoint"/>
        <mxPoint x="1090" y="440" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 9. Return to LangGraph -->
    <mxCell id="m9" value="9. return ApplyResult" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="345" y="500" as="sourcePoint"/>
        <mxPoint x="110" y="500" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- Note: debounce -->
    <mxCell id="note1" value="⚡ Step 6 is debounced (100ms)&#xa;to prevent UI flicker on rapid changes" style="shape=note;size=15;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
      <mxGeometry x="600" y="360" width="190" height="50" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
