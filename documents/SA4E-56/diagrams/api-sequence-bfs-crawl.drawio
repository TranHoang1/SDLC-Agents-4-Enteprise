<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="2" value="IndexingService" style="rounded=1;whiteSpace=wrap;fillColor=#1a1a2e;fontColor=#ffffff;strokeColor=#e94560;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="3" value="PegaHttpClient" style="rounded=1;whiteSpace=wrap;fillColor=#16213e;fontColor=#ffffff;strokeColor=#e94560;" vertex="1" parent="1">
      <mxGeometry x="200" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="4" value="Pega Platform" style="rhombus;whiteSpace=wrap;fillColor=#0f3460;fontColor=#ffffff;strokeColor=#533483;" vertex="1" parent="1">
      <mxGeometry x="380" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="5" value="Backend&#10;(/api/v1/pega)" style="rounded=1;whiteSpace=wrap;fillColor=#533483;fontColor=#ffffff;strokeColor=#e94560;" vertex="1" parent="1">
      <mxGeometry x="560" y="20" width="120" height="40" as="geometry"/>
    </mxCell>

    <!-- Flow labels -->
    <mxCell id="l1" value="1. detectProject / pega-project.json" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="80" width="280" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="l2" value="2. Build seed keys from app + case types" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="105" width="280" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="l3" value="3. Show 'Pega Project Detected' progress" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#00ff88;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="130" width="280" height="20" as="geometry"/>
    </mxCell>

    <!-- Loop header -->
    <mxCell id="loop" value="BFS Crawl Loop (max 1000 iterations)" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#e94560;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="175" width="300" height="25" as="geometry"/>
    </mxCell>

    <!-- Step a -->
    <mxCell id="a1" value="a. crawlPlan(ruleKeys, visitedKeys)" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="210" width="220" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="a1resp" value="← { missing, cached }" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#888888;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="210" width="180" height="20" as="geometry"/>
    </mxCell>

    <!-- Step b -->
    <mxCell id="b1" value="b. If no missing rules → BREAK" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#00ff88;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="240" width="250" height="20" as="geometry"/>
    </mxCell>

    <!-- Step c -->
    <mxCell id="c1" value="c. Take first 50 missing keys" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="270" width="250" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="c2" value="d. For each: getObject(className, key)" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="295" width="250" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="c3" value="← Rule JSON object" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#888888;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="295" width="180" height="20" as="geometry"/>
    </mxCell>

    <!-- Step d -->
    <mxCell id="d1" value="e. crawlBatch(rules, visitedKeys)" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="330" width="250" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="d1resp" value="← { stored, nextBatch }" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#888888;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="350" y="330" width="180" height="20" as="geometry"/>
    </mxCell>

    <!-- Step e -->
    <mxCell id="e1" value="f. Update visitedKeys + queue" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="360" width="280" height="20" as="geometry"/>
    </mxCell>

    <!-- Loop end -->
    <mxCell id="loopend" value="End Loop" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#e94560;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="400" width="300" height="25" as="geometry"/>
    </mxCell>

    <mxCell id="result" value="Return summary: totalRules, KB entries, Graph nodes" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#00ff88;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="20" y="430" width="350" height="20" as="geometry"/>
    </mxCell>

    <!-- Arrows -->
    <mxCell id="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=none;html=1;" edge="1" source="2" target="3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=none;html=1;" edge="1" source="3" target="4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jumpStyle=none;html=1;" edge="1" source="3" target="5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Legend -->
    <mxCell id="legend" value="Legend" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="560" y="100" width="120" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="lg1" value="🟢 Progress / Success" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#00ff88;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="130" width="200" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="lg2" value="⬜ Request" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="155" width="200" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="lg3" value="⬜ Response (gray)" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#888888;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="180" width="200" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="lg4" value="🔴 Error handling: catch + partial results" style="text;whiteSpace=wrap;html=1;fillColor=none;fontColor=#e94560;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="560" y="205" width="250" height="20" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
