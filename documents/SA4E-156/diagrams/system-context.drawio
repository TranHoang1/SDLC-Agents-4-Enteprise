    <!-- Edge: Developer → Extension (triggers) -->
    <mxCell id="e1" value="Index Workspace" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="actor1" target="ext1">
