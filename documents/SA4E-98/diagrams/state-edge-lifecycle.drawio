          <mxPoint x="200" y="240"/>
          <mxPoint x="200" y="280"/>
          <mxPoint x="300" y="280"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="note1" value="States are CONCEPTUAL &#10;(no state column in DB).&#10;Derived from existence of&#10;source/target in graph_nodes." style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;fontSize=9;align=left;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
