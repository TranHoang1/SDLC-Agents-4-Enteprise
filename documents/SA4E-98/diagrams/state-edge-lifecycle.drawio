    <mxCell id="title" value="Edge Lifecycle State Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="20" width="300" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="80" y="150" width="30" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="s1" value="ORPHANED&#10;&#10;Edge exists but target&#10;node NOT in graph_nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="200" y="120" width="200" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="RESOLVED&#10;&#10;Both source and target&#10;nodes exist in graph_nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="520" y="120" width="200" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="VALIDATED&#10;&#10;linkReverseEdges() confirmed&#10;edge on target node insert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="840" y="120" width="200" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="DIRECT&#10;&#10;Edge created when both&#10;source and target already exist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="520" y="300" width="200" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="createDependencyEdges()&#10;target NOT in graph_nodes" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=8;" edge="1" parent="1" source="start" target="s1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="target node ingested&#10;(projectRuleToGraphNode)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=8;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="linkReverseEdges()&#10;confirms connection" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=8;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="createDependencyEdges()&#10;target ALREADY in graph_nodes" style="html=1;verticalAlign=top;endArrow=block;endFill=1;fontSize=8;" edge="1" parent="1" source="start" target="s4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="95" y="340"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e5" value="reconcileAllEdges()&#10;backfills missing edge" style="html=1;verticalAlign=top;endArrow=block;endFill=1;fontSize=8;strokeColor=#9673a6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="300" y="200" as="sourcePoint"/>
