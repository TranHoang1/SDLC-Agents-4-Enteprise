<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Actor: Developer -->
    <mxCell id="n1" value="Developer" style="shape=mxgraph.basic.smiley;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="330" width="80" height="80" as="geometry"/>
    </mxCell>
    <!-- VS Code Extension boundary -->
    <mxCell id="boundary1" value="VS Code Extension" style="swimlane;startSize=30;fillColor=none;strokeColor=#0288d1;html=1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="220" y="120" width="440" height="500" as="geometry"/>
    </mxCell>
    <!-- PegaBfsIndexer -->
    <mxCell id="n2" value="PegaBfsIndexer&#xa;(BFS Loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="boundary1">
      <mxGeometry x="40" y="50" width="160" height="50" as="geometry"/>
    </mxCell>
    <!-- DataTableResolver (NEW) -->
    <mxCell id="n3" value="DataTableResolver&#xa;(Post-Processing)&#xa;★ NEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="boundary1">
      <mxGeometry x="40" y="180" width="160" height="60" as="geometry"/>
    </mxCell>
    <!-- PegaHttpClient -->
    <mxCell id="n4" value="PegaHttpClient&#xa;(REST Client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="boundary1">
      <mxGeometry x="260" y="110" width="150" height="50" as="geometry"/>
    </mxCell>
    <!-- PegaStreamIngester -->
    <mxCell id="n5" value="PegaStreamIngester&#xa;(KB Ingest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="boundary1">
      <mxGeometry x="260" y="240" width="150" height="50" as="geometry"/>
    </mxCell>
    <!-- Local Disk -->
    <mxCell id="n6" value="Local Disk&#xa;rules/*.pega.json" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;size=10;" vertex="1" parent="boundary1">
      <mxGeometry x="40" y="350" width="140" height="60" as="geometry"/>
    </mxCell>
    <!-- External: Pega Server -->
    <mxCell id="n7" value="Pega Server&#xa;(REST API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="800" y="200" width="160" height="60" as="geometry"/>
    </mxCell>
    <!-- External: KB Backend -->
    <mxCell id="n8" value="KB Backend&#xa;(Graph Store)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="800" y="400" width="160" height="60" as="geometry"/>
    </mxCell>
    <!-- Edge: Developer -> Extension -->
    <mxCell id="e1" value="indexWorkspace" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="n1" target="boundary1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Edge: BfsIndexer -> DataTableResolver -->
    <mxCell id="e2" value="BFS complete" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="boundary1" source="n2" target="n3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Edge: DataTableResolver -> PegaHttpClient -->
    <mxCell id="e3" value="getRuleByInsKey()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="boundary1" source="n3" target="n4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Edge: DataTableResolver -> PegaStreamIngester -->
    <mxCell id="e4" value="ingestSingleRule()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="boundary1" source="n3" target="n5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Edge: DataTableResolver -> Local Disk -->
    <mxCell id="e5" value="save .pega.json" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="boundary1" source="n3" target="n6">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Edge: PegaHttpClient -> Pega Server (cross-boundary) -->
    <mxCell id="e6" value="GET /rules/{insKey}" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="n4" target="n7">
      <mxGeometry relative="1" as="geometry"/>
