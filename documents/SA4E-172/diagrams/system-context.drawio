    <!-- Edge: PegaStreamIngester -> KB Backend (cross-boundary) -->
    <mxCell id="e7" value="POST /ingest-rule" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="n5" target="n8">
