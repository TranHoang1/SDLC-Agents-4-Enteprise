<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- State: Idle -->
    <mxCell id="s1" value="IDLE&#xa;(Workspace not indexed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="40" width="180" height="50" as="geometry"/>
    </mxCell>
    <!-- State: BFS Indexing -->
    <mxCell id="s2" value="BFS_INDEXING&#xa;(PegaBfsIndexer running)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="340" y="40" width="200" height="50" as="geometry"/>
    </mxCell>
    <!-- State: DataTable Resolution -->
