    <!-- Messages: Happy Path -->
    <mxCell id="m1" value="1. Click unenriched node" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="120" y="100" as="sourcePoint"/>
        <mxPoint x="340" y="100" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="m2" value="2. POST /api/admin/kb/entries/:id/enrich" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="340" y="140" as="sourcePoint"/>
        <mxPoint x="560" y="140" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="m3" value="3. Create task (priority=1, status=PENDING)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="560" y="180" as="sourcePoint"/>
        <mxPoint x="620" y="180" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
