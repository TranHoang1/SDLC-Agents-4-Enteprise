<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Title -->
    <mxCell id="title" value="Agent Lifecycle State Diagram" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="400" y="10" width="240" height="30" as="geometry"/>
    </mxCell>
    <!-- Start -->
    <mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="80" y="120" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- State: No Agent Selected (Fallback) -->
    <mxCell id="s1" value="NO_AGENT_SELECTED&#xa;(Fallback Mode)&#xa;---&#xa;• All agents concatenated&#xa;• All tools available&#xa;• Default model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="180" y="80" width="220" height="110" as="geometry"/>
    </mxCell>
    <!-- State: Agent Selected -->
    <mxCell id="s2" value="AGENT_SELECTED&#xa;(Isolated Mode)&#xa;---&#xa;• Agent body ONLY in prompt&#xa;• tools[] filtered&#xa;• model routed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="580" y="80" width="220" height="110" as="geometry"/>
    </mxCell>
    <!-- State: Processing (chat in progress) -->
    <mxCell id="s3" value="PROCESSING&#xa;(LLM Call Active)&#xa;---&#xa;• Config locked for turn&#xa;• In-flight tools use&#xa;  current agent config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="580" y="310" width="220" height="110" as="geometry"/>
    </mxCell>
    <!-- State: Switching -->
    <mxCell id="s4" value="SWITCHING&#xa;(Agent Transition)&#xa;---&#xa;• Resolve new config&#xa;• Last-write-wins&#xa;• &lt; 100ms target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="180" y="310" width="220" height="110" as="geometry"/>
    </mxCell>
    <!-- State: Error -->
    <mxCell id="s5" value="ERROR&#xa;(Graceful Degradation)&#xa;---&#xa;• Agent file missing&#xa;• Falls back to NO_AGENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="380" y="520" width="220" height="100" as="geometry"/>
    </mxCell>
    <!-- End -->
    <mxCell id="end" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
      <mxGeometry x="80" y="540" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- Transitions -->
    <mxCell id="t1" value="session start" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="start" target="s1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t2" value="selectAgent(id)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t3" value="SEND_PROMPT" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t4" value="LLM complete / STREAM_END" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="s3" target="s2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="860" y="365"/>
          <mxPoint x="860" y="135"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="t5" value="selectAgent(newId)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="s2" target="s4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="500" y="190"/>
          <mxPoint x="500" y="365"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="t6" value="config resolved" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="s4" target="s2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="290" y="240"/>
          <mxPoint x="690" y="240"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="t7" value="deselectAgent()" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="s2" target="s1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="500" y="60"/>
          <mxPoint x="500" y="60"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="t8" value="agent file missing / parse error" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#b85450;fontSize=9;" edge="1" parent="1" source="s4" target="s5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t9" value="fallback to default" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#b85450;fontSize=9;" edge="1" parent="1" source="s5" target="s1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="150" y="570"/>
          <mxPoint x="150" y="135"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="t10" value="session end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;fontSize=9;" edge="1" parent="1" source="s1" target="end">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Note: mid-session switch during PROCESSING -->
    <mxCell id="t11" value="selectAgent during processing&#xa;(deferred — applies on next turn)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;dashed=1;strokeColor=#d6b656;fontSize=9;" edge="1" parent="1" source="s3" target="s4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
