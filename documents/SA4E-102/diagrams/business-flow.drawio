<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Title -->
    <mxCell id="title" value="Business Flow: Index Jira Project → Knowledge Base" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="10" width="500" height="30" as="geometry"/>
    </mxCell>
    <!-- Swimlanes -->
    <mxCell id="lane_user" value="Developer / Agent" style="swimlane;startSize=30;fillColor=#e1f5fe;strokeColor=#0288d1;html=1;fontStyle=1;fontSize=11;horizontal=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="50" width="1300" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="lane_ext" value="Extension (IndexingService)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontStyle=1;fontSize=11;horizontal=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="250" width="1300" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="lane_backend" value="Backend (KB + Graph)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontStyle=1;fontSize=11;horizontal=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="470" width="1300" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="lane_jira" value="Jira API" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;html=1;fontStyle=1;fontSize=11;horizontal=0;" vertex="1" parent="1">
      <mxGeometry x="40" y="670" width="1300" height="180" as="geometry"/>
    </mxCell>
    <!-- User Lane Nodes -->
    <mxCell id="n_start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_user">
      <mxGeometry x="60" y="80" width="30" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="n_trigger" value="Trigger Index&#xa;(Command Palette&#xa;OR jira_get_issue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=10;" vertex="1" parent="lane_user">
      <mxGeometry x="140" y="65" width="160" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_select_project" value="Select/Confirm&#xa;Project Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=10;" vertex="1" parent="lane_user">
      <mxGeometry x="360" y="65" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_view_progress" value="View Progress&#xa;(Output Panel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=10;" vertex="1" parent="lane_user">
      <mxGeometry x="900" y="65" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_search" value="mem_search&#xa;(hit KB, no API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="lane_user">
      <mxGeometry x="1100" y="65" width="140" height="60" as="geometry"/>
    </mxCell>
    <!-- Extension Lane Nodes -->
    <mxCell id="n_decision" value="Mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="lane_ext">
      <mxGeometry x="170" y="70" width="100" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n_jql" value="Build JQL Query&#xa;project={KEY}&#xa;batch=50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="lane_ext">
      <mxGeometry x="360" y="40" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_single" value="Extract Single&#xa;Ticket Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="lane_ext">
      <mxGeometry x="360" y="130" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_transform" value="Transform →&#xa;KB Entry Format&#xa;(JIRA | ticket=...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="lane_ext">
      <mxGeometry x="570" y="70" width="160" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_ingest" value="Call mem_ingest&#xa;(upsert by source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="lane_ext">
      <mxGeometry x="800" y="70" width="150" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_graph" value="Create Graph&#xa;Node + Edges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="lane_ext">
      <mxGeometry x="1020" y="70" width="140" height="60" as="geometry"/>
    </mxCell>
    <!-- Backend Lane Nodes -->
    <mxCell id="n_kb_store" value="KB: Ingest Entry&#xa;(BM25 indexed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="lane_backend">
      <mxGeometry x="800" y="70" width="150" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_graph_store" value="Graph DB:&#xa;TICKET node +&#xa;DEPENDS_ON edges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="lane_backend">
      <mxGeometry x="1020" y="70" width="150" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_end" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="lane_backend">
      <mxGeometry x="1220" y="85" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- Jira Lane Nodes -->
    <mxCell id="n_jira_fetch" value="JQL Search&#xa;(pagination batch=50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="lane_jira">
      <mxGeometry x="360" y="50" width="160" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n_jira_single" value="GET /issue/{key}&#xa;(single fetch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="lane_jira">
      <mxGeometry x="570" y="50" width="150" height="60" as="geometry"/>
    </mxCell>
    <!-- Edges — User Lane -->
    <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="lane_user" source="n_start" target="n_trigger">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="lane_user" source="n_trigger" target="n_select_project">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- User → Extension -->
    <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n_select_project" target="n_decision">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Decision branches -->
    <mxCell id="f4" value="Full Batch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;" edge="1" parent="lane_ext" source="n_decision" target="n_jql">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f5" value="On-demand" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=9;" edge="1" parent="lane_ext" source="n_decision" target="n_single">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Extension → Jira -->
    <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="n_jql" target="n_jira_fetch">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;" edge="1" parent="1" source="n_single" target="n_jira_single">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Jira → Transform -->
    <mxCell id="f8" value="ticket data" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;dashed=1;fontSize=9;" edge="1" parent="1" source="n_jira_fetch" target="n_transform">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f9" value="ticket data" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;dashed=1;fontSize=9;" edge="1" parent="1" source="n_jira_single" target="n_transform">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Transform → Ingest → Graph -->
    <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="lane_ext" source="n_transform" target="n_ingest">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="lane_ext" source="n_ingest" target="n_graph">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Extension → Backend -->
    <mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="n_ingest" target="n_kb_store">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="n_graph" target="n_graph_store">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Graph Store → End -->
    <mxCell id="f14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="lane_backend" source="n_graph_store" target="n_end">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Progress feedback -->
    <mxCell id="f15" value="progress events" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#999999;fontSize=9;" edge="1" parent="1" source="n_ingest" target="n_view_progress">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Search from KB -->
    <mxCell id="f16" value="subsequent queries" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#82b366;fontSize=9;" edge="1" parent="1" source="n_kb_store" target="n_search">
