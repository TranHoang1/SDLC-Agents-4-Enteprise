        <mxPoint x="340" y="580" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="m12" value="12. Backoff retry (1s, 2s, 4s...)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
