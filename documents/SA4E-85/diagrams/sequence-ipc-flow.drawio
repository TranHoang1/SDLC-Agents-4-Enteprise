    <mxCell id="m13" value="13. IPC_STATUS(kiro: disconnected)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1">
