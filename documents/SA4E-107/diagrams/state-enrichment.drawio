<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Title -->
    <mxCell id="title" value="Enrichment Task State Machine" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="10" width="300" height="30" as="geometry"/>
    </mxCell>
    <!-- Start -->
    <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="100" y="90" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- PENDING -->
    <mxCell id="s1" value="PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="80" width="140" height="50" as="geometry"/>
    </mxCell>
    <!-- PROCESSING -->
    <mxCell id="s2" value="PROCESSING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="250" width="140" height="50" as="geometry"/>
    </mxCell>
    <!-- COMPLETED -->
    <mxCell id="s3" value="COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="100" y="450" width="140" height="50" as="geometry"/>
    </mxCell>
    <!-- FAILED -->
    <mxCell id="s4" value="FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="450" width="140" height="50" as="geometry"/>
    </mxCell>
    <!-- RETRY_PENDING (intermediate) -->
    <mxCell id="s5" value="RETRY&#xa;(backoff wait)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="520" y="250" width="120" height="50" as="geometry"/>
    </mxCell>
    <!-- End (completed) -->
    <mxCell id="end1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
      <mxGeometry x="155" y="560" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- End (permanently failed) -->
    <mxCell id="end2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
      <mxGeometry x="555" y="560" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- Edges -->
    <!-- start -> PENDING -->
    <mxCell id="e1" value="Task created" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="start" target="s1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- PENDING -> PROCESSING -->
    <mxCell id="e2" value="TaskWorker picks up" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- PROCESSING -> COMPLETED -->
    <mxCell id="e3" value="LLM success +&#xa;store enrichment" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- PROCESSING -> RETRY (failure with retries left) -->
    <mxCell id="e4" value="Error + retries &lt; 3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1" source="s2" target="s5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- RETRY -> PENDING -->
    <mxCell id="e5" value="Backoff elapsed&#xa;(5s/15s/45s)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#d6b656;" edge="1" parent="1" source="s5" target="s1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="700" y="275"/>
          <mxPoint x="700" y="105"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- PROCESSING -> FAILED (max retries) -->
    <mxCell id="e6" value="Error + retries = 3&#xa;(max exhausted)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="s2" target="s4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="320" y="380"/>
          <mxPoint x="570" y="380"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- COMPLETED -> end -->
    <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s3" target="end1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- FAILED -> end (permanent) -->
    <mxCell id="e8" value="Permanent failure" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="s4" target="end2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- FAILED -> PENDING (manual retry by operator) -->
    <mxCell id="e9" value="Operator manual retry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;dashed=1;strokeColor=#0288d1;" edge="1" parent="1" source="s4" target="s1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="800" y="475"/>
          <mxPoint x="800" y="105"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Legend -->
    <mxCell id="legend" value="Legend:&#xa;Solid = happy path&#xa;Orange = retry path&#xa;Red = failure path&#xa;Blue dashed = manual intervention" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="40" y="640" width="200" height="80" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
