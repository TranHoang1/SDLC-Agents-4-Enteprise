<mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Participant: Code Indexer -->
    <mxCell id="h1" value="Code Indexer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <!-- Participant: TaskCreator -->
    <mxCell id="h2" value="TaskCreator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="280" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <!-- Participant: TaskWorker -->
    <mxCell id="h3" value="TaskWorker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <!-- Participant: LLMService -->
    <mxCell id="h4" value="LLMService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <!-- Participant: symbols DB -->
    <mxCell id="h5" value="symbols DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="940" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <!-- Lifelines -->
    <mxCell id="l1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="120" y="60" as="sourcePoint"/>
        <mxPoint x="120" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="340" y="60" as="sourcePoint"/>
        <mxPoint x="340" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="560" y="60" as="sourcePoint"/>
        <mxPoint x="560" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="780" y="60" as="sourcePoint"/>
        <mxPoint x="780" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="l5" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1000" y="60" as="sourcePoint"/>
        <mxPoint x="1000" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- Messages -->
    <!-- 1. Indexer stores symbols -->
    <mxCell id="m1" value="1. storeResults(symbols)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="120" y="100" as="sourcePoint"/>
        <mxPoint x="1000" y="100" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 2. Store body embeddings -->
    <mxCell id="m2" value="2. extractAndStoreBodies()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="120" y="150" as="sourcePoint"/>
        <mxPoint x="1000" y="150" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 3. Indexer -> TaskCreator: create tasks -->
    <mxCell id="m3" value="3. createEnrichmentTasks(symbolIds)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="120" y="200" as="sourcePoint"/>
        <mxPoint x="340" y="200" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 4. TaskCreator inserts pending tasks -->
    <mxCell id="m4" value="4. INSERT pending_tasks (CODE_ENRICHMENT)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="340" y="250" as="sourcePoint"/>
        <mxPoint x="1000" y="250" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 5. Return to indexer (non-blocking) -->
    <mxCell id="m5" value="5. return (non-blocking)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="340" y="300" as="sourcePoint"/>
        <mxPoint x="120" y="300" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- Note: async boundary -->
    <mxCell id="note1" value="--- Async Boundary (indexing complete) ---" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="300" y="330" width="500" height="20" as="geometry"/>
    </mxCell>
    <!-- 6. TaskWorker polls -->
    <mxCell id="m6" value="6. poll() — find PENDING tasks" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="560" y="370" as="sourcePoint"/>
        <mxPoint x="1000" y="370" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 7. Return task -->
    <mxCell id="m7" value="7. PendingTask{symbolId, kind}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1000" y="410" as="sourcePoint"/>
        <mxPoint x="560" y="410" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 8. TaskWorker loads symbol -->
    <mxCell id="m8" value="8. SELECT symbol + body_embeddings" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="560" y="460" as="sourcePoint"/>
        <mxPoint x="1000" y="460" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 9. Return symbol data -->
    <mxCell id="m9" value="9. {name, signature, body, doc_comment}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1000" y="500" as="sourcePoint"/>
        <mxPoint x="560" y="500" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 10. TaskWorker -> LLM -->
    <mxCell id="m10" value="10. complete(prompt, timeout=30s)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="560" y="550" as="sourcePoint"/>
        <mxPoint x="780" y="550" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 11. LLM response -->
    <mxCell id="m11" value="11. {summary, pseudo_code, tags}" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="780" y="600" as="sourcePoint"/>
        <mxPoint x="560" y="600" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 12. Store enrichment -->
    <mxCell id="m12" value="12. UPDATE symbols SET summary, pseudo_code, llm_tags" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="560" y="650" as="sourcePoint"/>
        <mxPoint x="1000" y="650" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- 13. Mark completed -->
    <mxCell id="m13" value="13. UPDATE task SET status=COMPLETED" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="560" y="700" as="sourcePoint"/>
        <mxPoint x="1000" y="700" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- Error path annotation -->
    <mxCell id="m14" value="[timeout/error] Mark FAILED, retry" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="780" y="750" as="sourcePoint"/>
        <mxPoint x="560" y="750" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
  </root>
</mxGraphModel>
