<mxGraphModel adaptiveColors="auto" dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="780" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="trig" value="Issue Detected&#10;(extension failure / health check fail / tool regression)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="370" y="20" width="260" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="sev" value="Severity Assessment" style="rhombus;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="400" y="110" width="200" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="critical" value="CRITICAL&#10;Immediate rollback" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="80" y="240" width="200" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="minor" value="MINOR / WORKAROUND&#10;Hotfix — no rollback" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="720" y="240" width="220" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="step1" value="Step 1: Stop / unload extension&#10;(VS Code reload window)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="80" y="340" width="240" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="db" value="Step 2: Database rollback&#10;(NONE — no DB change)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="80" y="420" width="240" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="prev" value="Step 3: Install previous VSIX&#10;code --install-extension&#10;sdlc-agents-4-enterprise-1.18.0.vsix --force" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="80" y="500" width="240" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="cfg" value="Step 4: Restore configuration&#10;(settings, credentials)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="80" y="600" width="240" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="verif" value="Step 5: Verify rollback&#10;(health :9181, tools/list, smoke tests)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="80" y="680" width="240" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="vq" value="Rollback verified?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="430" y="660" width="180" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="success" value="ROLLBACK SUCCESSFUL&#10;Report: error + restored version" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="700" y="640" width="240" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="fail" value="FAILED — escalate&#10;do NOT retry deploy without approval" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="700" y="720" width="240" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="trig" target="sev">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sev" target="critical">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sev" target="minor">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="critical" target="step1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step1" target="db">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="prev">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prev" target="cfg">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cfg" target="verif">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="verif" target="vq">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vq" target="success">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="vq" target="fail">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="legend2" value="LEGEND&#10;Red = rollback path / critical&#10;Yellow = minor / hotfix&#10;Green = success&#10;No DB migration — Step 2 is a no-op" style="text;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
      <mxGeometry x="720" y="20" width="240" height="80" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
