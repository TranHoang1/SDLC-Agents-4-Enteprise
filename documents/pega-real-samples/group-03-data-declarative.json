[
  {
    "pxObjClass": "Rule-Obj-Property", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyPropertyName": "LoanAmount", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyPropertyType": "Double", "pyPropertyMode": "Single", "pyLabel": "Requested Loan Amount", "pyRequired": true
  },
  {
    "pxObjClass": "Rule-Obj-Class", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pySuperClassName": "Work-", "pyClassGroup": "PegaSample-CustomerLoan-Work", "pyClassType": "Work"
