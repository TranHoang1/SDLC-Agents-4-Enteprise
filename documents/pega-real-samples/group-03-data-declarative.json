    "pxObjClass": "Rule-Declare-Collection", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLabel": "LoanFormFieldCollection", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
