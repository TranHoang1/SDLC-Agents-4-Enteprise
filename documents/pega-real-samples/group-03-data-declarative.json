    "pyActions": [
      { "pyActionId": "ACT-1", "pyActionType": "Set", "pyTarget": ".InterestRate", "pySource": "Primary.BaseRate + 0.025", "pyWhenCondition": "IsStandardApplicant" },
      { "pyActionId": "ACT-2", "pyActionType": "Apply Data Transform", "pyTarget": "PegaSample-CustomerLoan-Work-LoanApplication.InitializeCustomerProfile" },
      { "pyActionId": "ACT-3", "pyActionType": "ForEachPage", "pyTarget": ".CollateralList", "pySource": "pyWorkPage.CollateralDetails" }
    ]
  },
  {
    "pxObjClass": "Rule-Declare-Pages", "pyPageName": "D_CustomerProfile", "pyDataPageClass": "PegaSample-Data-Customer", "pyScope": "Thread", "pyListOrSingle": "Page", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyDataSources": [{ "pySourceType": "REST", "pyDataSource": "PegaSample-Data-Customer.FetchCustomerRestService", "pyDataTransform": "PegaSample-Data-Customer.MapRestCustomerResponse" }]
  },
  {
    "pxObjClass": "Rule-Declare-Expressions", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "targetProperty": ".TotalRepaymentAmount", "changeHandling": "WHENEVER_INPUT_CHANGES", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "expressionLogic": [
      { "condition": "IsShortTermLoan", "formula": ".LoanAmount * (1 + (.InterestRate * .LoanTenureMonths / 12))" },
      { "condition": "OTHERWISE",       "formula": ".LoanAmount * (1 + .InterestRate) ^ (.LoanTenureMonths / 12)" }
    ]
  },
  {
    "pxObjClass": "Rule-Declare-Trigger", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLabel": "OnLoanApprovalStatusChange", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyTriggerEvent": "After-Save", "pyWhenName": "IsLoanStatusChangedToApproved", "pyActivityName": "NotifyApplicantOnApproval", "pyRunMode": "Deferred"
  },
  {
    "pxObjClass": "Rule-Declare-OnChange", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLabel": "RecalculateOnAmountChange", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyWatchProperties": [".LoanAmount", ".LoanTenureMonths", ".InterestRate"],
    "pyActivityName": "PegaSample-CustomerLoan-Work-LoanApplication.RecalculateRepayment"
  },
  {
    "pxObjClass": "Rule-Declare-Index", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyIndexName": "CollateralItemIndex", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyPageListProperty": ".CollateralList", "pyIndexedProperties": [".CollateralType", ".CollateralValue", ".pxRefObjectInsName"]
  },
  {
    "pxObjClass": "Rule-Declare-Constraint", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLabel": "MaximumLoanAmountConstraint", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyPropertyName": ".LoanAmount", "pyConstraintType": "Maximum", "pyConstraintValue": "5000000",
    "pyErrorMessage": "Loan amount cannot exceed 5,000,000."
  },
  {
    "pxObjClass": "Rule-FieldValue", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyFieldName": "LoanPurpose", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
