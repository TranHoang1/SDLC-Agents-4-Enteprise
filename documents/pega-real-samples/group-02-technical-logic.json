  {
    "pxObjClass": "Rule-File-JS", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyRuleName": "LoanCalculatorScript", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyContent": "function recalcInstallment(p, r, n) { return p * (r/12) / (1 - Math.pow(1+r/12,-n)); }"
