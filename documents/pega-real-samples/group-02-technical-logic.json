[
  {
    "pxObjClass": "Rule-Obj-Activity", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyActivityName": "ProcessLoanApproval", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "steps": [
