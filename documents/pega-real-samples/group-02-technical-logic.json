  {
    "pxObjClass": "Rule-Utility-Function", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyFunctionName": "CalculateMonthlyInstallment", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyFunctionLibrary": "LoanCalculationLibrary",
    "pyReturnType": "Double",
    "pyParameters": [
      { "pyParamName": "principal",    "pyParamType": "Double" },
      { "pyParamName": "annualRate",   "pyParamType": "Double" },
      { "pyParamName": "termMonths",   "pyParamType": "Integer" }
    ],
    "pyExpression": "principal * (annualRate/12) / (1 - Math.pow(1 + annualRate/12, -termMonths))"
  },
  {
    "pxObjClass": "Rule-Utility-Library", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLibraryName": "LoanCalculationLibrary", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
