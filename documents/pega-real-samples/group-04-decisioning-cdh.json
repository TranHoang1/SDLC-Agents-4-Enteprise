      { "pyField1": ".LoanAmount",   "pyOperator": ">",      "pyField2": "50000" },
      { "pyField1": "",              "pyOperator": "isTrue", "pyWhenName": "IsFirstTimeBorrower" }
    ]
  },
  {
    "pxObjClass": "Rule-Decision-Strategy", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLabel": "NextBestLoanOfferStrategy", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
