    "pyTableRows": [
      { "pyRowId": "ROW-DT-1", "pyConditions": [{ "pyOperator": ">=", "pyValue": "750" }, { "pyOperator": "<=", "pyValue": "0.35" }], "pyReturnActions": [{ "pyReturnValue": "\"TIER_1_AUTO_APPROVE\"" }] },
      { "pyRowId": "ROW-DT-2", "pyConditions": [{ "pyOperator": ">=", "pyValue": "650" }, { "pyOperator": "<=", "pyValue": "0.45" }], "pyReturnActions": [{ "pyReturnValue": "\"TIER_2_MANUAL_REVIEW\"" }] },
      { "pyRowId": "ROW-DT-3", "pyConditions": [{ "pyOperator": "<",  "pyValue": "650" }, { "pyOperator": "ANY" }],                  "pyReturnActions": [{ "pyReturnValue": "\"TIER_3_DECLINE\"" }] }
    ]
  },
  {
