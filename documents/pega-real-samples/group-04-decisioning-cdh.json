    "pyBranches": [
      { "pyPropertyName": ".CreditScore", "pyWhenName": "CreditScoreAbove750", "pyReturnTransform": "SetPremiumRate" },
      { "pyPropertyName": ".CreditScore", "pyWhenName": "CreditScore600to749", "pyReturnTransform": "SetStandardRate" },
      { "pyPropertyName": ".CreditScore", "pyWhenName": "CreditScoreBelow600",  "pyReturnTransform": "SetHighRiskRate" }
    ]
  },
  {
