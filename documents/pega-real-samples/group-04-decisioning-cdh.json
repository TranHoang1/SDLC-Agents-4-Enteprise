      { "pyPropertyName": ".DebtToIncomeRatio",  "pyWeight": 30, "pyBands": [{ "pyMax": 0.30, "pyPoints": 100 }, { "pyMax": 0.45, "pyPoints": 60 }, { "pyMax": 1, "pyPoints": 10 }] },
      { "pyPropertyName": ".EmploymentYears",    "pyWeight": 20, "pyBands": [{ "pyMin": 5, "pyPoints": 100 }, { "pyMin": 2, "pyPoints": 60 }, { "pyMin": 0, "pyPoints": 20 }] },
      { "pyPropertyName": ".CollateralValue",    "pyWeight": 10, "pyBands": [{ "pyMin": 200000, "pyPoints": 100 }, { "pyMin": 50000, "pyPoints": 60 }, { "pyMin": 0, "pyPoints": 0 }] }
    ]
  },
