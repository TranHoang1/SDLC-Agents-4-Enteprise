[
  {
    "pxObjClass": "Rule-Declare-DecisionTable", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLabel": "DetermineLoanApprovalTier", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyPropertyEvaluated": ".ApprovalTier",
    "pyTableColumns": [
      { "pyPropertyName": ".CreditScore", "pyHeaderLabel": "Credit Score" },
      { "pyPropertyName": ".DebtToIncomeRatio", "pyHeaderLabel": "DTI Ratio" }
