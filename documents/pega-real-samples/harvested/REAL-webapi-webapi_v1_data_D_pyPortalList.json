"\n    \n    \n      \u003c!-- START PTC-Authentication Override -- Set variables so we can track login time later --\u003e\n\t\t\n      \u003cscript\u003e\n        sessionStorage.setItem(\u0027trialType\u0027, \u0027PegaTrialTypeAcademy\u0027);\n        sessionStorage.setItem(\u0027ceInitialSignonScreenRenderDateTime\u0027, new Date());\n        sessionStorage.setItem(\u0027ceInitialSignonFlag\u0027, \u0027true\u0027);\n        sessionStorage.removeItem(\u0027ceFirstSignonForThisOperatorID\u0027);\n\t\t\n      \u003c/script\u003e\n      \u003c!-- END PTC-Authentication Override -- Set variables so we can track login time later --\u003e\n        \u003c!DOCTYPE html\u003e\n        \n        \n        \u003chtml lang=\u0027en-us\u0027\u003e\n        \n        \u003chead\u003e\n            \u003cmeta http-equiv=\"Content-type\" content=\"text/html;charset=UTF-8\" /\u003e\n            \u003cmeta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" /\u003e\n            \u003cmeta name=\"application-name\" content=\"Login Page\"\u003e\n            \u003cmeta name=\"description\" content=\"Login Page\"\u003e\n            \n            \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\"\u003e\n            \n            \u003clink rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"images/pzPegaIcon32.png\"\u003e\n            \u003clink rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"images/pzPegaIcon16.png\"\u003e\n            \u003clink rel=\"shortcut icon\" href=\"images/pzPegaIcon.ico\"\u003e\n            \u003c!-- START PTC-Authentication Override -- Change title of window based on type of trial --\u003e\n            \u003ctitle\u003e\n                Academy exercise system\n            \u003c/title\u003e\n            \u003c!-- END PTC-Authentication Override -- Change title of window based on type of trial --\u003e\n            \u003clink rel=\u0027stylesheet\u0027 type=\u0027text/css\u0027 href=\u0027webwb/py-login-screen.css\u0027 /\u003e\n            \u003cstyle\u003e\n                .captchaImg {\n                    background: url(\u0027/prweb/app/default/ai2rRSYKJFcQR6ODxs26Rv4aBkqwV-K5*/!STANDARD?pyActivity=Code-Security.pyGenerateCaptcha\u0027) no-repeat 0 0;\n                    width: 155px;\n                    height: 50px;\n                    margin: auto;\n                    background-color: #FFF;\n                }\n            \u003c/style\u003e\n          \u003cscript\u003e\n             window.addEventListener(\u0027load\u0027, function() {\n               let width = 120;\n               document.querySelectorAll(\"div#credentials label\").forEach(function (labelDiv) {\n                  width = labelDiv \u0026\u0026 labelDiv.offsetWidth \u003e width ? labelDiv.offsetWidth : width\n               });\n               document.body.style.setProperty(\"--label-width\", `${width}px`);\n             })\n          \u003c/script\u003e\n            \n        \u003c/head\u003e\n        \u003cbody onload=\"processOnLoad()\"\u003e\n        \u003cmain role=\"main\"\u003e\n            \u003ch1 class=\"sr-only\"\u003eLogin Page\u003c/h1\u003e\n            \n\n            \n            \n                \n                \u003cform name=\"main\" method=\"post\" onSubmit=\"return sendLoginRequestForm(event);\" action=\"/prweb/app/default/ai2rRSYKJFcQR6ODxs26Rv4aBkqwV-K5*/!STANDARD\" novalidate=\"novalidate\" target=\"_top\" \u003e\n                    \n                    \n                    \u003cinput type=\"hidden\" name=\"pzAuth\" value=\"guest\" /\u003e\n                    \u003cdiv class=\"logo-container\"\u003e\n                    \u003cimg src= \u0027webwb/pzpega-logo.svg\u0027 class=\"logo\" alt=\"Pega Logo\" /\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"content-container\"\u003e\n                \u003c!-- START PTC-Authentication Override -- When sso and on tenant OR on sso and on Community Edition, show Welcome message --\u003e\n                \u003cxpega:when test=\u0027(pxRequestor.pxReqServlet==\"sso\")\u0027 \u003e\n                  \u003cdiv id=\"trial-message\"\u003e\n\t\t\t\t            \u003cp class=\"trial-message-welcome\" style=\"margin:0;\"\u003eWelcome to your Academy exercise system.\u003c/p\u003e\n\t\t\t\t\t          \u003cp class=\"trial-message-text\"\u003ePlease log in with the user name and password specified in the challenge. \u003c/p\u003e\n                  \u003c/div\u003e\n                \u003c/xpega:when\u003e\n                \u003c!-- END PTC-Authentication Override -- When sso and on tenant, show Welcome message --\u003e\n                      \u003cdiv id=\"login\"\u003e\n                            \u003cdiv id=\"errorDiv\"\u003e\n                                \n                            \u003c/div\u003e\n                            \n                            \n\n\n                            \u003cdiv id=\"credentials\"\u003e\n                                \u003cdiv id=\"credentialsForm\"\u003e\n                                    \u003cdiv class=\"field user\"\u003e\n                                        \u003clabel for=\"txtUserID\"\u003e\n                                            \u003csvg aria-hidden=\"true\" class=\"svg-icon\"  xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 25 25\" focusable=\"false\" preserveAspectRatio=\"xMinYMin\"\u003e\u003ctitle\u003eUser name\u003c/title\u003e\u003cpath d=\"M15.16 12.92a8.51 8.51 0 0 1 4.54 3.19 9.09 9.09 0 0 1 1.81 5.4v1.49a.48.48 0 0 1-.54.54c-.32 0-.49-.18-.49-.54v-1.49a8 8 0 0 0-8-8 7.72 7.72 0 0 0-5.67 2.34 7.75 7.75 0 0 0-2.34 5.67v1.48c0 .36-.17.54-.49.54s-.49-.18-.49-.54v-1.49a9 9 0 0 1 6.35-8.64 6 6 0 0 1-2.44-2.18 5.75 5.75 0 0 1-.93-3.19 5.78 5.78 0 0 1 1.76-4.25 5.8 5.8 0 0 1 4.25-1.76 5.78 5.78 0 0 1 4.24 1.76 5.74 5.74 0 0 1 1.76 4.25 5.75 5.75 0 0 1-.93 3.19 5.9 5.9 0 0 1-2.44 2.18zm-6.16-1.92a4.8 4.8 0 0 0 3.52 1.47 4.84 4.84 0 0 0 3.48-1.47 4.78 4.78 0 0 0 1.5-3.5 4.