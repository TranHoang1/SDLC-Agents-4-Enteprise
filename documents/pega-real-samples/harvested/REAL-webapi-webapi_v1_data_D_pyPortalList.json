entDefault(); }\n                    p.onkeypress = function(event) { return event.preventDefault(); }\n                }\n                u.readOnly = !visibility;\n                p.readOnly = !visibility;\n            }\n\n            function toggleForgotLink(visibility) {\n                var forgotLink = document.getElementById(\u0027spnLoginFrgtPwd\u0027);\n                if (visibility) {\n                    forgotLink.style.visibility = \u0027\u0027;\n                } else {\n                    forgotLink.style.visibility = \u0027hidden\u0027;\n                }\n            }\n\n            function removeErrorMessage() {\n                toggleLoginButton(false);\n                if(!isHybridClient \u0026\u0026 !isPegaElectronContainer) {\n                    toggleForgotLink(false);\n                }\n                var error = document.getElementById(\"error\");\n                if(error) {\n                    error.innerHTML = \"\";\n                    error.style.display = \"none\";\n                }\n            }\n\n            function changeCaptcha() {\n                var captchaSrc = \"/prweb/app/default/ai2rRSYKJFcQR6ODxs26Rv4aBkqwV-K5*/!STANDARD?pyActivity=Code-Security.pyGenerateCaptcha\"+\"\u0026\"+(new Date()).getTime();\n                document.getElementById(\"captchaDiv\").style.backgroundImage = \"url(\u0027\"+captchaSrc+\"\u0027)\";\n            }\n\n            function processOnLoad() {\n                toggleLoginButton(true);\n                \n                if(typeof processOnLoadMobile == \"function\") {\n                    window.onLaunchboxLoaded = processOnLoadMobile;\n                }\n                else {\n                    try {\n                        document.getElementById(\"txtUserID\").focus();\n                    }\n                    catch(err){}\n                }\n                /* START PTC-Authentication Override -- Show popup if academy user enters wrong user name/password */\n                \n                  \n                \n                /* END PTC-Authentication Override -- Show popup if academy user enters wrong user name/password */\n            }\n\n            function sendLoginRequestForm(e) {\n                /* START PTC-Authentication Override -- Set variables so we can track login time later */\n                sessionStorage.setItem(\u0027ceInitialSignonStartDateTime\u0027, new Date());\n                /* END PTC-Authentication Override -- Set variables so we can track login time later */\n              \n                return true; // use normal form submit\n            }\n            function clickForgotButton(){\n                toggleForgotLink(false);\n                document.getElementById(\u0027txtUserID\u0027).value=\"\";\n                document.getElementById(\u0027txtPassword\u0027).value=\"\";\n                document.getElementById(\u0027sub_forgotpwd\u0027).click();\n            }\n        \u003c/script\u003e\n        \n        \u003c/body\u003e\n        \u003c/html\u003e\n    \n"
