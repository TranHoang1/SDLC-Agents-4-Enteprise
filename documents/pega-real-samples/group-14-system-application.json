  {
    "pxObjClass": "Rule-RuleSet-Name",
    "pyClassName": "@baseclass",
    "pyRulesetName": "PegaSampleLoan",
    "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyDescription": "Core ruleset for the PegaSampleLoan loan processing application",
    "pyRequiresAuthentication": true,
    "pyAllowedClassGroups": ["PegaSample-CustomerLoan-Work", "PegaSample-Data"]
  },
  {
    "pxObjClass": "Rule-RuleSet-Version",
    "pyClassName": "@baseclass",
    "pyRulesetName": "PegaSampleLoan",
