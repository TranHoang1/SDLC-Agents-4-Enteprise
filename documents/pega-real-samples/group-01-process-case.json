[
  {
    "pxObjClass": "Rule-Obj-Flow", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyFlowName": "LoanApplicationLifecycle", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
