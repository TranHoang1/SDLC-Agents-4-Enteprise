  {
    "pxObjClass": "Rule-Obj-Step", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyStepName": "CollectDocumentsStep", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
