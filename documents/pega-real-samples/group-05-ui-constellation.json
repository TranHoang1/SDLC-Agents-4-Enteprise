[
  {
    "pxObjClass": "Rule-HTML-Section", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pySectionName": "ApplicantDetailsSection", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyIncludedSections": [{ "pySectionName": "PersonalInfoSubSection" }, { "pySectionName": "EmploymentInfoSubSection" }],
    "pyControls": [
      { "pyPropertyName": ".FirstName",   "pyControlType": "pxTextInput",      "pyLabel": "First Name",    "pyRequired": true },
      { "pyPropertyName": ".LoanAmount",  "pyControlType": "pxCurrency",       "pyLabel": "Loan Amount",   "pyRequired": true },
      { "pyPropertyName": ".LoanPurpose", "pyControlType": "pxDropdown",       "pyLabel": "Loan Purpose",  "pyFieldValueClass": "PegaSample-CustomerLoan-Work-LoanApplication" }
    ],
    "pyEvents": [
      { "pyEventName": "OnChange", "pyPropertyName": ".LoanAmount", "pyDataTransform": "RecalculateRepayment" }
    ]
  },
  {
    "pxObjClass": "Rule-HTML-Harness", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyHarnessName": "PerformLoanApplication", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyHarnessType": "Perform",
    "pyLayoutGroups": [
      { "pyGroupLabel": "Applicant Details", "pySectionName": "ApplicantDetailsSection" },
      { "pyGroupLabel": "Loan Summary",      "pySectionName": "LoanSummarySection" }
    ]
  },
  {
    "pxObjClass": "Rule-HTML-Property", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyControlName": "LoanAmountInput", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyControlType": "Currency", "pyCurrencySymbol": "VND",
    "pyMinValue": 10000, "pyMaxValue": 5000000, "pyDecimalPlaces": 0,
    "pyTooltip": "Enter the total loan amount you need"
  },
  {
    "pxObjClass": "Rule-Portal", "pyClassName": "@baseclass", "pyPortalName": "LoanOfficerPortal", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyPortalType": "Manager",
    "pyDefaultHarness": "PerformLoanApplication",
    "pyNavigationItems": [
      { "pyLabel": "My Worklist",    "pyURL": "/pega/mywork" },
      { "pyLabel": "Loan Reports",   "pyURL": "/pega/reports" },
      { "pyLabel": "Administration", "pyURL": "/pega/admin", "pyWhenVisible": "IsSystemAdmin" }
    ]
  },
  {
    "pxObjClass": "Rule-UI-Skin", "pyClassName": "@baseclass", "pySkinName": "LoanPortalSkin", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyThemeColor": "#003366", "pyAccentColor": "#0088CC", "pyFontFamily": "Inter, Roboto, sans-serif",
    "pyButtonRadius": "4px", "pyCardShadow": "0 2px 4px rgba(0,0,0,0.15)"
  },
  {
    "pxObjClass": "Rule-UI-View", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyViewName": "LoanApplicationSummaryView", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyViewTemplate": "CaseSummary", "pyVisibleFields": [".LoanAmount", ".InterestRate", ".TotalRepaymentAmount", ".pyStatusWork"],
    "pyLayout": "twoColumn"
  },
  {
    "pxObjClass": "Rule-File-Binary", "pyClassName": "@baseclass", "pyRuleName": "BankLogoImage", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyMimeType": "image/png", "pyFileExtension": "png", "pyFileSizeKB": 24, "pyLabel": "Bank Corporate Logo"
  },
  {
    "pxObjClass": "Rule-UI-Component", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyComponentName": "LoanCalculatorWidget", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyComponentType": "Constellation",
    "pyInputProps": [{ "pyName": "loanAmount", "pyType": "Double" }, { "pyName": "termMonths", "pyType": "Integer" }],
    "pyOutputProps": [{ "pyName": "monthlyInstallment", "pyType": "Double" }]
  },
  {
    "pxObjClass": "Rule-UI-Navigation", "pyClassName": "@baseclass", "pyNavName": "LoanOfficerMainMenu", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyNavItems": [
      { "pyLabel": "Dashboard",   "pyTarget": "LoanDashboardHarness", "pyIcon": "pi-dashboard" },
      { "pyLabel": "New Loan",    "pyTarget": "NewLoanApplicationHarness", "pyIcon": "pi-add" },
      { "pyLabel": "My Cases",    "pyTarget": "MyWorkHarness", "pyIcon": "pi-folder" }
    ]
  },
  {
    "pxObjClass": "Rule-UI-Paragraph", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyParagraphName": "LoanTermsConditions", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyContent": "By submitting this application, you agree to our Terms and Conditions. Interest rates are subject to change. Final approval is subject to credit verification."
  },
  {
    "pxObjClass": "Rule-UI-Theme", "pyClassName": "@baseclass", "pyThemeName": "LoanPortalDarkTheme", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyBackgroundColor": "#1a1a2e", "pyTextColor": "#e0e0e0", "pyCardBackground": "#16213e"
  },
  {
    "pxObjClass": "Rule-UI-Layout", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyLayoutName": "LoanApplicationTwoColumnLayout", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyColumns": 2, "pyGutter": "16px", "pyStackOnMobile": true
  },
  {
    "pxObjClass": "Rule-UI-FieldGroup", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyViewName": "ApplicantPersonalInfoFieldGroup", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyGroupLabel": "Personal Information",
    "pyFields": [".FirstName", ".LastName", ".DateOfBirth", ".NationalID", ".PhoneNumber"]
  },
  {
    "pxObjClass": "Rule-UI-Card", "pyClassName": "PegaSample-CustomerLoan-Work-LoanApplication", "pyViewName": "LoanSummaryCardView", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyPrimaryField": ".LoanAmount", "pySecondaryFields": [".InterestRate", ".LoanTenureMonths"],
    "pyStatusField": ".pyStatusWork", "pyActionButton": "ReviewLoanAction"
  },
  {
    "pxObjClass": "Rule-UI-Icon", "pyClassName": "@baseclass", "pyIconName": "LoanDocumentIcon", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyIconType": "SVG", "pyIconCategory": "Document", "pyLabel": "Loan Document"
  },
  {
    "pxObjClass": "Rule-UI-Control", "pyClassName": "@baseclass", "pyControlName": "LoanStatusBadge", "pyRuleset": "PegaSampleLoan", "pyRulesetVersion": "01-01-01",
    "pyControlType": "Badge", "pyColorMapping": [
      { "pyValue": "New",              "pyColor": "#aaa" },
      { "pyValue": "Pending-Approval", "pyColor": "#f0a500" },
      { "pyValue": "Approved",         "pyColor": "#28a745" },
      { "pyValue": "Declined",         "pyColor": "#dc3545" }
    ]
  }
]
