<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Title -->
    <mxCell id="title" value="State Machine: Compact Session States" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="20" width="400" height="30" as="geometry"/>
    </mxCell>
    <!-- Initial state (filled circle) -->
    <mxCell id="init" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="100" y="150" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- State: IDLE -->
    <mxCell id="s1" value="IDLE&#xa;&#xa;Normal chat operation&#xa;No compact running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="240" y="120" width="200" height="80" as="geometry"/>
    </mxCell>
    <!-- State: COMPACTING -->
    <mxCell id="s2" value="COMPACTING&#xa;&#xa;Summarizing or truncating&#xa;isCompacting = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="600" y="120" width="220" height="80" as="geometry"/>
    </mxCell>
    <!-- State: DEBOUNCE_ACTIVE -->
    <mxCell id="s3" value="DEBOUNCE_ACTIVE&#xa;&#xa;Auto-compact fired&#xa;Waiting for hysteresis reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="400" y="380" width="240" height="80" as="geometry"/>
    </mxCell>
    <!-- Edge: init → IDLE -->
    <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="130" y="165" as="sourcePoint"/>
        <mxPoint x="240" y="160" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    <!-- Edge: IDLE → COMPACTING -->
    <mxCell id="e1" value="/compact command&#xa;OR usagePercent &gt;= threshold" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Edge: COMPACTING → IDLE (manual complete or fallback) -->
    <mxCell id="e2" value="complete (manual)&#xa;OR fallback applied" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="655" y="80"/>
          <mxPoint x="390" y="80"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Edge: COMPACTING → DEBOUNCE_ACTIVE (auto complete) -->
    <mxCell id="e3" value="complete (auto trigger)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <!-- Edge: DEBOUNCE_ACTIVE → IDLE (hysteresis reset) -->
    <mxCell id="e4" value="usagePercent &lt; (threshold - 10%)&#xa;→ reset debounce" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="s3" target="s1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="240" y="420"/>
          <mxPoint x="240" y="200"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Legend -->
    <mxCell id="legend" value="Legend" style="swimlane;startSize=20;fillColor=none;strokeColor=#666666;html=1;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="800" y="350" width="250" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="lg1" value="Green = Normal/Ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="legend">
      <mxGeometry x="10" y="30" width="130" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="lg2" value="Yellow = Processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="legend">
      <mxGeometry x="10" y="70" width="130" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="lg3" value="Blue = Waiting/Debounce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="legend">
      <mxGeometry x="10" y="110" width="130" height="30" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
