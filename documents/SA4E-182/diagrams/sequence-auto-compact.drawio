    <!-- Messages -->
    <mxCell id="m1" value="1. stateChange(usagePercent=95)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="120" y="130" as="sourcePoint"/>
