<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <!-- Title -->
    <mxCell id="title" value="Enrichment Status State Machine" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="380" y="20" width="300" height="30" as="geometry"/>
    </mxCell>
    <!-- Initial state -->
    <mxCell id="s0" value="" style="ellipse;html=1;shape=doubleCircle;whiteSpace=wrap;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="80" y="200" width="30" height="30" as="geometry"/>
    </mxCell>
    <!-- States -->
    <mxCell id="s1" value="NOT_INDEXED&#xa;(symbol does not exist)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="160" y="190" width="180" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="INDEXED&#xa;(enrichment_status = NULL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="420" y="190" width="200" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="TASK_QUEUED&#xa;(pending_tasks.status = PENDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="700" y="190" width="220" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="PROCESSING&#xa;(pending_tasks.status = PROCESSING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="700" y="340" width="220" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="s5" value="COMPLETED&#xa;(enrichment_status = COMPLETED&#xa;summary NOT NULL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="420" y="470" width="220" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="s6" value="FAILED&#xa;(enrichment_status = FAILED&#xa;retries exhausted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="700" y="470" width="220" height="60" as="geometry"/>
    </mxCell>
    <!-- Transitions -->
    <mxCell id="t0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;" edge="1" parent="1" source="s0" target="s1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t1" value="tree-sitter indexing" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;" edge="1" parent="1" source="s1" target="s2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t2" value="TaskCreator creates task" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;" edge="1" parent="1" source="s2" target="s3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t3" value="TaskWorker picks task" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;" edge="1" parent="1" source="s3" target="s4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t4" value="LLM success + store" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;" edge="1" parent="1" source="s4" target="s5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t5" value="LLM error (retries exhausted)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;strokeColor=#b85450;" edge="1" parent="1" source="s4" target="s6">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="t6" value="retry (count &lt; 3)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;strokeColor=#d6b656;" edge="1" parent="1" source="s4" target="s3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="960" y="365"/>
          <mxPoint x="960" y="215"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="t7" value="admin re-enrich or file changed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;dashed=1;" edge="1" parent="1" source="s6" target="s3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="990" y="500"/>
          <mxPoint x="990" y="130"/>
          <mxPoint x="810" y="130"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="t8" value="file re-indexed (content changed)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;fontSize=8;dashed=1;" edge="1" parent="1" source="s5" target="s2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="530" y="420"/>
          <mxPoint x="520" y="420"/>
          <mxPoint x="520" y="280"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <!-- Legend -->
    <mxCell id="leg1" value="Legend:" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="60" y="560" width="60" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="leg2" value="Solid = normal flow | Dashed = recovery/re-enrich | Red = error path" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="60" y="580" width="400" height="20" as="geometry"/>
    </mxCell>
  </root>
