{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte"],
    "rootDir": ".",
    "outDir": "../../out/webview",
    "paths": {
      "@stores/*": ["./stores/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.svelte"
  ],
  "exclude": ["node_modules"]
}
