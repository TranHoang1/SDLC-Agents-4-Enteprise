# SA4E-223 Environment Template — STAGING
# Copy to `.env.staging` and inject real values via CI secret manager / vault.
# DO NOT commit real secrets. Use ${VAR} references or a secret store.

NODE_ENV=staging
PORT=48721

DATABASE_ADAPTER=postgresql
# Managed Postgres (staging). Inject credentials from secret manager.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_INTERVAL_MS=5000
TASK_WORKER_MAX_RETRIES=3
TASK_WORKER_BACKOFF_BASE_MS=1000
TASK_WORKER_MAX_CONCURRENT=2
TASK_WORKER_DEAD_LETTER_ENABLED=true

CODE_INTEL_ENABLED=true
CODE_INTEL_MAX_BATCH_SIZE=100
CODE_INTEL_UPLOAD_TIMEOUT_MS=30000
CODE_INTEL_VECTOR_ENABLED=true

ONNX_RUNTIME_URL=http://onnx-runtime.staging.internal:8080
ONNX_MODEL_PATH=./models/all-MiniLM-L6-v2

# Secrets MUST come from the CI/CD secret store, never hardcoded here.
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
