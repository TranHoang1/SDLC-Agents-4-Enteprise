# SA4E-223 Environment Template — PRODUCTION
# Copy to `.env.prod` and inject real values via CI secret manager / vault ONLY.
# DO NOT commit real secrets. All sensitive values use ${VAR} placeholders.

NODE_ENV=production
PORT=48721

DATABASE_ADAPTER=postgresql
# Managed Postgres (production). Credentials injected from secret manager at deploy.
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_INTERVAL_MS=10000
TASK_WORKER_MAX_RETRIES=5
TASK_WORKER_BACKOFF_BASE_MS=1000
TASK_WORKER_MAX_CONCURRENT=4
TASK_WORKER_DEAD_LETTER_ENABLED=true

CODE_INTEL_ENABLED=true
CODE_INTEL_MAX_BATCH_SIZE=200
CODE_INTEL_UPLOAD_TIMEOUT_MS=60000
CODE_INTEL_VECTOR_ENABLED=true

ONNX_RUNTIME_URL=http://onnx-runtime.prod.internal:8080
ONNX_MODEL_PATH=./models/all-MiniLM-L6-v2

# Secrets MUST be provided by the deployment platform secret store.
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
